# ─── Mux API access (fetch your catalogue) ──────────────────────────────────
# Create an Access Token: https://dashboard.mux.com/settings/access-tokens
# Without these the app runs in "demo mode" using the curated seed catalogue.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ─── Mux signed playback (private videos) ───────────────────────────────────
# Only needed if your assets use the "signed" playback policy.
# Create a Signing Key: https://dashboard.mux.com/settings/signing-keys
#   MUX_SIGNING_KEY  = the signing key ID (short string shown in the dashboard)
#   MUX_PRIVATE_KEY  = the base64-encoded private key for that signing key
# SECURITY: keep the private key in .env.local (gitignored) — never commit it.
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
